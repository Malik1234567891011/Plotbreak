{
  "name": "plotbreak",
  "private": true,
  "version": "0.1.0",
  "description": "Project ANIMA — anime roleplay RPG. The model interprets intent. The game engine determines truth. The AI director makes truth entertaining.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "api": "npm run dev -w @plotbreak/api",
    "clean": "rm -rf packages/*/dist services/*/dist node_modules/.cache",
    "smoke": "tsx --env-file-if-exists=.env infra/scripts/smoke.ts",
    "i18n:extract": "tsx infra/scripts/i18n-extract.ts",
    "fr:lint": "tsx infra/scripts/fr-lint.ts",
    "fr:size": "tsx infra/scripts/fr-size.ts",
    "fr:identical": "tsx infra/scripts/fr-identical.ts",
    "fr:probe": "tsx infra/scripts/fr-parser-probe.ts",
    "art": "tsx infra/scripts/generate-art.ts",
    "brand": "tsx infra/scripts/generate-brand.ts",
    "migrate": "tsx infra/scripts/migrate.ts",
    "grant": "tsx --env-file-if-exists=.env infra/scripts/grant-credits.ts",
    "moderate": "tsx --env-file-if-exists=.env infra/scripts/moderate.ts",
    "media:trace": "tsx --env-file-if-exists=.env infra/scripts/media-trace.ts",
    "crashes": "tsx --env-file-if-exists=.env infra/scripts/crashes.ts",
    "playtest": "node infra/scripts/playtest-read.mjs",
    "replay-cases": "tsx --env-file-if-exists=.env infra/scripts/replay-cases.ts",
    "report": "tsx --env-file-if-exists=.env infra/scripts/report.ts",
    "transcript": "tsx --env-file-if-exists=.env infra/scripts/transcript.ts",
    "playthrough": "tsx --env-file-if-exists=.env infra/scripts/playthrough.ts",
    "seed:social": "tsx --env-file-if-exists=.env infra/scripts/seed-social.ts",
    "fr:manifest": "tsx infra/scripts/fr-manifest.ts",
    "fr:adapt": "tsx --env-file-if-exists=.env infra/scripts/fr-adapt.ts",
    "fr:qa": "tsx infra/scripts/fr-qa.ts",
    "fr:stale": "tsx infra/scripts/fr-stale.ts",
    "fr:smoke": "tsx --env-file-if-exists=.env infra/scripts/fr-smoke.ts",
    "context-run": "tsx --env-file-if-exists=.env infra/scripts/context-run.ts",
    "relaunch-playtest": "tsx --env-file-if-exists=.env infra/scripts/relaunch-playtest.ts",
    "timeskip-probe": "tsx --env-file-if-exists=.env infra/scripts/timeskip-probe.ts",
    "reaction-probe": "tsx --env-file-if-exists=.env infra/scripts/reaction-probe.ts",
    "attribution-probe": "tsx --env-file-if-exists=.env infra/scripts/attribution-probe.ts",
    "zoom-probe": "tsx --env-file-if-exists=.env infra/scripts/zoom-probe.ts",
    "latency-probe": "tsx --env-file-if-exists=.env infra/scripts/latency-probe.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

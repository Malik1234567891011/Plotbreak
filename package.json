{
  "name": "plotbreak",
  "private": true,
  "version": "0.1.0",
  "description": "Project ANIMA \u2014 anime roleplay RPG. The model interprets intent. The game engine determines truth. The AI director makes truth entertaining.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "api": "npm run dev -w @plotbreak/api",
    "clean": "rm -rf packages/*/dist services/*/dist node_modules/.cache",
    "smoke": "tsx --env-file-if-exists=.env infra/scripts/smoke.ts",
    "i18n:extract": "tsx infra/scripts/i18n-extract.ts",
    "fr:lint": "tsx infra/scripts/fr-lint.ts",
    "fr:probe": "tsx infra/scripts/fr-parser-probe.ts",
    "art": "tsx infra/scripts/generate-art.ts",
    "brand": "tsx infra/scripts/generate-brand.ts",
    "migrate": "tsx infra/scripts/migrate.ts",
    "playtest": "node infra/scripts/playtest-read.mjs",
    "playthrough": "tsx --env-file-if-exists=.env infra/scripts/playthrough.ts",
    "seed:social": "tsx --env-file-if-exists=.env infra/scripts/seed-social.ts",
    "fr:manifest": "tsx infra/scripts/fr-manifest.ts",
    "fr:adapt": "tsx --env-file-if-exists=.env infra/scripts/fr-adapt.ts",
    "fr:qa": "tsx infra/scripts/fr-qa.ts",
    "fr:stale": "tsx infra/scripts/fr-stale.ts",
    "fr:smoke": "tsx --env-file-if-exists=.env infra/scripts/fr-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

# Copy to .env. Everything here is optional: with none of it set the API runs
# on the in-process store, the development token verifier and the rule-based
# pipeline, which is a supported mode and how `npm run api` works out of the box.

# --- Persistence -----------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Apply the schema and seed the official catalog with `npm run migrate`.
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Supabase → Project Settings → API. SUPABASE_URL alone is enough for a project
# on asymmetric signing keys; SUPABASE_JWT_SECRET is the legacy shared secret.
# A production process refuses to start without one of them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Models ----------------------------------------------------------------
# Either one. With neither, the deterministic rule-based pipeline runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Force a provider when both keys are present: anthropic | openai
MODEL_PROVIDER=

# --- Purchases -------------------------------------------------------------
# App Store Connect → Users and Access → Integrations → App Store Connect API.
# Without these a production build refuses to credit any purchase rather than
# crediting one it cannot verify.
APP_STORE_BUNDLE_ID=com.plotbreak.app
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=

# Google Play Developer API, for the Android build.
PLAY_PACKAGE_NAME=com.plotbreak.app
PLAY_ACCESS_TOKEN=

# --- Media -----------------------------------------------------------------
# Where generated art is served from. Defaults to this process in development.
MEDIA_CDN_BASE_URL=

# --- Process ---------------------------------------------------------------
PORT=4000
PUBLIC_BASE_URL=
NODE_ENV=development

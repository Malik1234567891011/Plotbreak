# Generated art masters — regenerable via infra/scripts/generate-art.ts.
# The optimized .webp derivatives are committed; the PNGs are not.
infra/seed/assets/**/*.png

# Runtime-generated media: a hero frame belongs to one turn and a portrait to
# one player, so neither is seed content. Both are regenerated on demand.
infra/seed/assets/hero/
infra/seed/assets/player/

# Xcode machine-local config
apps/ios/Plotbreak/Config/Local.xcconfig
apps/ios/build/
apps/ios/DerivedData/
*.xcuserstate
xcuserdata/

# Cover v4 masters (6MB PNGs); only READMEs, briefs and contact sheets are tracked
docs/covers-v4/**/*.png

# Ad renders. `docs/ads/<campaign>/README.md` and `briefs/` are the work worth
# keeping; `cut/`, `ui/`, `vo/` and `ref/` are 164 MB of video and audio output
# from Seedance/ElevenLabs and do not belong in the repo. Ignored explicitly
# rather than left untracked, because untracked is one `git add .` from being
# committed for good.
docs/ads/**/cut/
docs/ads/**/ui/
docs/ads/**/vo/
docs/ads/**/ref/
docs/ads/**/sfx/
